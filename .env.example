# Copy this Worker secret to the ignored `.dev.vars` file for local development.
# Set the production value with Wrangler or in the Cloudflare dashboard.
HN_GLANCE_SCREENSHOT_AGENT_TOKEN=
HN_GLANCE_TURNSTILE_SECRET=

# Local development pairs Cloudflare's always-passing Turnstile test secret
# (1x0000000000000000000000000000000AA) with its reported hostname.
HN_GLANCE_TURNSTILE_HOSTNAMES=example.com
