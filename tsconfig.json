{
  // https://nuxt.com/docs/guide/concepts/typescript
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    ".nuxt/nuxt.d.ts",
    ".nuxt/types/**/*.d.ts",
    "./**/*.ts",
    "./**/*.vue",
    "shared/**/*.ts"
  ]
}
